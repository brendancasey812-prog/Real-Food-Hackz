# Copy this file to .env.local for local development, and paste the same
# values into Vercel → Settings → Environment Variables for the deployment.
#
# .env.local is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Firebase (cloud sync + Google sign-in)
# ---------------------------------------------------------------------------
# From Firebase Console → Project settings → Your apps → Web app → SDK setup.
# These are PUBLIC by design (they ship in the browser bundle). Your data is
# protected by Firestore Security Rules — see firestore.rules — not by hiding
# these values.
#
# Leave them all blank to run the app in local-only mode (localStorage).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Anthropic (recipe scan / paste)
# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — no NEXT_PUBLIC_ prefix, so it is never sent to the browser.
# Set this in Vercel and the app's AI features work for everyone with no key
# entry. Leave it unset and each user supplies their own key in Settings.
ANTHROPIC_API_KEY=
