rules_version = '2';

// Security Rules for Real Food Hackz.
//
// The app stores each account's whole data blob at users/{uid}. These rules are
// what actually protect your data — the Firebase web config in the browser is
// public by design, so the rules must assume anyone can attempt a request.
//
// Paste this into: Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user may read and write only their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
